# ==============================================================================
# HRMS - Environment Variables Template (.env.example)
# Copy this file to '.env' and populate real credentials for production/staging.
# ==============================================================================

# ── ASP.NET Core Runtime Configuration ──
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5096

# ── Application URLs & CORS ──
App__FrontendBaseUrl=https://your-hrms-domain.com
App__InvitationExpiryHours=72
Cors__AllowedOrigins__0=https://your-hrms-domain.com
Cors__AllowedOrigins__1=http://localhost:4200
Cors__AllowedOrigins__2=http://127.0.0.1:4200

# ── SQL Server Database Architecture (Multi-Tenant) ──
# 1. Default Tenant Database
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_SERVER;Database=HRMS_Production;User Id=sa;Password=YOUR_STRONG_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# 2. Master Catalog Database
ConnectionStrings__MasterConnection=Server=YOUR_SQL_SERVER;Database=HRMS_Master;User Id=sa;Password=YOUR_STRONG_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# 3. Dynamic Provisioning Base Connection Strings
Tenancy__TenantConnectionBase=Server=YOUR_SQL_SERVER;User Id=sa;Password=YOUR_STRONG_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
Tenancy__ProvisioningConnectionBase=Server=YOUR_SQL_SERVER;User Id=sa;Password=YOUR_STRONG_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# ── JWT Authentication (JSON Web Tokens) ──
# Must be at least 32 characters long for HMAC-SHA256
Jwt__Issuer=Hrms.Api
Jwt__Audience=Hrms.Client
Jwt__Key=REPLACE_WITH_A_VERY_LONG_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
Jwt__ExpiryMinutes=480

# ── Email Service (SMTP) ──
Email__Enabled=true
Email__Host=smtp.gmail.com
Email__Port=587
Email__UseSsl=true
Email__UserName=your-email@domain.com
Email__Password=your-google-app-password
Email__FromAddress=no-reply@domain.com
Email__FromName=HRMS Portal

SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__UseSsl=true
SmtpSettings__SenderName=HRMS Portal
SmtpSettings__SenderEmail=no-reply@domain.com
SmtpSettings__Username=your-email@domain.com
SmtpSettings__Password=your-google-app-password
SmtpSettings__SimulationMode=false

# ── Cloudinary Cloud Media Storage ──
Cloudinary__CloudName=your_cloudinary_cloud_name
Cloudinary__ApiKey=your_cloudinary_api_key
Cloudinary__ApiSecret=your_cloudinary_api_secret
Cloudinary__UploadPreset=your_unsigned_preset_if_any

# ── Company & Attendance Defaults ──
Company__DefaultTimeZone=Asia/Kolkata
Attendance__CloseoutWorkerEnabled=true
Attendance__CloseoutIntervalMinutes=60
