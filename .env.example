# ==============================================================================
# HRMS Backend Environment Template (.env.example)
# Copy this file to '.env' and fill in your deployment credentials.
# ==============================================================================

# ── Database Connection Strings ──
DEFAULT_CONNECTION="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DEFAULT_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Persist Security Info=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"
MASTER_CONNECTION="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_MASTER_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Persist Security Info=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"
TENANT_CONNECTION_BASE="Data Source=YOUR_DB_SERVER;User ID=YOUR_USER;Password=YOUR_PASSWORD;Persist Security Info=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"
PROVISIONING_CONNECTION_BASE="Data Source=YOUR_DB_SERVER;User ID=YOUR_USER;Password=YOUR_PASSWORD;Persist Security Info=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"

# ── Email / SMTP Settings ──
SMTP_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER="your-email@domain.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@domain.com"
SMTP_FROM_NAME="HRMS Portal"
SMTP_SIMULATION_MODE=false

# ── Cloudinary Media CDN Settings ──
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Security & Authentication ──
JWT_KEY="your-super-secret-production-signing-key-at-least-32-chars-long"
JWT_ISSUER="Hrms.Api"
JWT_AUDIENCE="Hrms.Client"
JWT_EXPIRY_MINUTES=480

# ── Application URLs ──
FRONTEND_BASE_URL="https://your-frontend-domain.com"
INVITATION_EXPIRY_HOURS=72
